# Copy to .env and fill in. Never commit .env — it is gitignored.
#   cp .env.example .env

# ── Database ────────────────────────────────────────────────────────────
# Postgres connection string (local, Neon, Supabase, Railway, …)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# ── Auth.js / NextAuth v5 ───────────────────────────────────────────────
# Generate one with:  npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET=""

# App origin. Used to build Stripe success/cancel redirect URLs.
# Change to your real domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── OAuth: Google ───────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# The "Authorized redirect URI" must match EXACTLY, including scheme and port:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── OAuth: GitHub ───────────────────────────────────────────────────────
# GitHub → Settings → Developer settings → OAuth Apps
# "Authorization callback URL" must match EXACTLY:
#   http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Payments: Stripe ────────────────────────────────────────────────────
# Secret key from dashboard.stripe.com/apikeys (sk_test_… while in test mode)
STRIPE_API_KEY=""
# Webhook signing secret. For local dev, run:
#   stripe listen --forward-to localhost:3000/api/webhook
# and copy the whsec_… value it prints.
STRIPE_WEBHOOK_SECRET=""

# ── File uploads: EdgeStore ─────────────────────────────────────────────
# dashboard.edgestore.dev → your project → keys
EDGE_STORE_ACCESS_KEY=""
EDGE_STORE_SECRET_KEY=""

# ── Images: Cloudinary ──────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ── AI chat: Ollama (optional) ──────────────────────────────────────────
# Runs against a local Ollama by default. Point this at a reachable host if
# you deploy — the browser calls it directly, so localhost will not work
# for users in production.
NEXT_PUBLIC_OLLAMA_HOST="http://127.0.0.1:11434"
