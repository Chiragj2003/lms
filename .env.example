# Copy to .env and fill in. Never commit .env — it is gitignored.
#   cp .env.example .env

# ── App origin ──────────────────────────────────────────────────────────
# Change to your real domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (Postgres, e.g. Neon) ──────────────────────────────────────
# Neon → your project → Connection string (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── Auth: Clerk ─────────────────────────────────────────────────────────
# Clerk Dashboard → Configure → API keys.
# In `npm run dev` you can leave both empty: Clerk then creates temporary
# keys by itself. Production (e.g. Vercel) needs real keys.
# Sign-in methods (email, Google, GitHub, …) are turned on in the Clerk
# Dashboard → User & authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"

# ── Payments: Razorpay ──────────────────────────────────────────────────
# dashboard.razorpay.com → Account & Settings → API Keys (rzp_test_… for test mode).
# Set both or neither. Without them, paid courses can't be bought unless
# DEMO_CHECKOUT is on.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret you set on the /api/webhook endpoint in the Razorpay dashboard (optional).
RAZORPAY_WEBHOOK_SECRET=""
# Demo gateway: enrolls learners WITHOUT charging them. Local/demo only;
# ignored once the Razorpay keys are set.
DEMO_CHECKOUT="false"

# ── AI assistant: Google Gemini ─────────────────────────────────────────
# aistudio.google.com → Get API key. Leave empty to turn the assistant off.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

# ── File uploads: EdgeStore ─────────────────────────────────────────────
# dashboard.edgestore.dev → your project → keys
EDGE_STORE_ACCESS_KEY=""
EDGE_STORE_SECRET_KEY=""

# ── Images: Cloudinary ──────────────────────────────────────────────────
# The upload widget uses an unsigned upload preset named "learnit"
# (Cloudinary → Settings → Upload → Upload presets).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Server-only. Never prefix these with NEXT_PUBLIC_.
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
