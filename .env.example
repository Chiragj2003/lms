# Copy to .env and fill in. Never commit .env — it is gitignored.
#   cp .env.example .env

# ── Database ────────────────────────────────────────────────────────────
# Postgres connection string (local, Neon, Supabase, Railway, …)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# ── Auth: Better Auth ───────────────────────────────────────────────────
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# App origin. Used as the sign-in (Better Auth) base URL.
# Change to your real domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── OAuth: Google ───────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# The "Authorized redirect URI" must match EXACTLY, including scheme and port:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── OAuth: GitHub ───────────────────────────────────────────────────────
# GitHub → Settings → Developer settings → OAuth Apps
# "Authorization callback URL" must match EXACTLY:
#   http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Payments: Razorpay ──────────────────────────────────────────────────
# Keys from dashboard.razorpay.com → Account & Settings → API Keys.
# While these are empty, checkout falls back to a demo gateway that enrolls
# learners without charging them. Setting them switches the demo off.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret you set on the /api/webhook endpoint in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=""

# ── File uploads: EdgeStore ─────────────────────────────────────────────
# dashboard.edgestore.dev → your project → keys
EDGE_STORE_ACCESS_KEY=""
EDGE_STORE_SECRET_KEY=""

# ── Images: Cloudinary ──────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ── AI chat: Ollama (optional) ──────────────────────────────────────────
# Called from the server (/api/ai/chat), never the browser. Leave empty to
# turn the AI assistant off. Locally, a running Ollama works as-is; in
# production use a host your server can reach, e.g. Ollama Cloud
# (https://ollama.com) with an API key.
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_API_KEY=""
OLLAMA_MODEL="qwen2.5-coder:latest"
