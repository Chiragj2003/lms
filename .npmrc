legacy-peer-deps=true

# Cold CI installs (Vercel with no build cache) were dying with ECONNRESET
# mid-download. npm only retries twice by default; these give it room to ride
# out a dropped connection instead of failing the whole build.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
